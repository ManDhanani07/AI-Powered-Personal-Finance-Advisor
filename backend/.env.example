# Application Configuration
APP_NAME="AI-Powered Personal Finance Advisor API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super-secret-production-key-change-in-env-file-32-chars

# Admin Security Credentials
ADMIN_EMAIL=mandhanani536@gmail.com
ADMIN_PASSWORD_HASH=

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_advisor_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_advisor_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/finance_advisor_db

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/backend.log

# Email / SMTP Configuration (Gmail App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name
